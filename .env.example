# Optional local API port; default used by pnpm start.
PORT=4200
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
BACKUP_RETENTION_DAYS=7
BACKUP_DIR=data/backups
# Optional owner-configured HTTPS alert destination.
BACKUP_ALERT_WEBHOOK_URL=
BACKUP_ALERT_TOKEN=

# Exact source SHA set by the release process; omitted reports local-unversioned.
# APP_REVISION=

# Public PostgreSQL server: node --import tsx server/hosted-index.ts
# Keep secrets outside Git. Public mode never creates published demo accounts.
DATABASE_URL=
SEATLY_PUBLIC_ORIGIN=
# Optional first-start array of {name,email,role,password}; existing accounts are not overwritten.
# Require individual passwords of at least 20 characters; remove this value after provisioning.
SEATLY_BOOTSTRAP_ACCOUNTS=
